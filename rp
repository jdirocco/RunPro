def sh(cmd, check=True, capture=True):
    r = subprocess.run(cmd, cwd=ROOT, text=True, capture_output=capture)
    if check and r.returncode != 0:
        sys.exit(f"command failed: {' '.join(cmd)}\n{r.stderr}")
    return r.stdout.strip() if capture else ""


GH_RETRIES = 3


def gh_json(args):
    """Run a read-only gh command and parse its JSON output.

    GitHub's API fails transiently now and then (gh reports e.g. "unknown owner type" when its
    owner lookup query fails), so retry with a short backoff before giving up. Only reads go
    through here: retrying them is safe.
    """
    cmd = ["gh"] + args
    for attempt in range(1, GH_RETRIES + 1):
        r = subprocess.run(cmd, cwd=ROOT, text=True, capture_output=True)
        if r.returncode == 0:
            out = r.stdout.strip()
            return json.loads(out) if out else []
        if attempt < GH_RETRIES:
            delay = 2 ** attempt
            print(f"gh failed ({r.stderr.strip() or 'no output'}), retrying in {delay}s...", file=sys.stderr)
            time.sleep(delay)
    sys.exit(f"command failed after {GH_RETRIES} attempts: {' '.join(cmd)}\n{r.stderr}")


def load_config():
    if os.path.exists(CONFIG):
        with open(CONFIG) as f:
            return json.load(f)
    return {}


def save_config(cfg):
    with open(CONFIG, "w") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")


def repo():
    return load_config().get("repo") or sh(["gh", "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"])


# ---------- backlog parsing ----------

BLOCK = re.compile(r"^### ([a-z0-9-]+): (.+)$", re.M)


def parse_backlog():
    text = open(BACKLOG).read()
    starts = [m for m in BLOCK.finditer(text)]
    items = []
    for i, m in enumerate(starts):
        end = starts[i + 1].start() if i + 1 < len(starts) else len(text)
        chunk = text[m.end():end]
        meta, body_lines, in_meta = {}, [], True
        for line in chunk.strip("\n").splitlines():
            mm = re.match(r"^- (milestone|labels|depends|issue):\s*(.*)$", line)
            if in_meta and mm:
                meta[mm.group(1)] = mm.group(2).strip()
            else:
                in_meta = False
                body_lines.append(line)
        items.append({
            "key": m.group(1), "title": m.group(2).strip(),
            "milestone": meta.get("milestone", ""),
            "labels": [x.strip() for x in meta.get("labels", "").split(",") if x.strip()],
            "depends": [x.strip() for x in meta.get("depends", "").split(",") if x.strip()],
            "issue": int(meta["issue"]) if meta.get("issue", "").isdigit() else None,
            "body": "\n".join(body_lines).strip(),
        })
    return text, items


def write_issue_number(key, number):
    text = open(BACKLOG).read()
    pat = re.compile(r"(^### " + re.escape(key) + r": .*?^- issue:)[ \t]*$", re.M | re.S)
    text, n = pat.subn(lambda m: f"{m.group(1)} {number}", text, count=1)
    if n != 1:
        sys.exit(f"could not write issue number for {key}")
    open(BACKLOG, "w").write(text)


def key_to_issue():
    return {it["key"]: it["issue"] for it in parse_backlog()[1]}


# ---------- project helpers ----------

def project_set_status(issue_number, status_name):
    cfg = load_config()
    proj = cfg.get("project")
    if not proj:
        return
    owner, number = proj["owner"], str(proj["number"])
    items = gh_json(["project", "item-list", number, "--owner", owner, "--format", "json", "--limit", "500"])
    item_id = next((i["id"] for i in items.get("items", [])
                    if i.get("content", {}).get("number") == issue_number), None)
    if not item_id:
        return
    fields = gh_json(["project", "field-list", number, "--owner", owner, "--format", "json"])
    status = next(f for f in fields["fields"] if f["name"] == "Status")
    option = next((o["id"] for o in status["options"] if o["name"] == status_name), None)
    if option:
        sh(["gh", "project", "item-edit", "--id", item_id, "--project-id", proj["id"],
            "--field-id", status["id"], "--single-select-option-id", option])


# ---------- commands ----------

def cmd_sync(_args):
    r = repo()
    existing = {l["name"] for l in gh_json(["label", "list", "-R", r, "--json", "name", "--limit", "200"])}
    for name, color in LABELS.items():
        if name not in existing:
            sh(["gh", "label", "create", name, "-R", r, "--color", color])
            print(f"label {name}")
    ms = gh_json(["api", f"repos/{r}/milestones?state=all&per_page=100"])
    have = {m["title"] for m in ms}
    for title in MILESTONES.values():
        if title not in have:
            sh(["gh", "api", f"repos/{r}/milestones", "-f", f"title={title}"])
            print(f"milestone {title}")
    cfg = load_config()
    _, items = parse_backlog()
    for it in items:
        if it["issue"]:
            continue
        deps = [key_to_issue().get(d) for d in it["depends"]]
        body = it["body"]
        if it["depends"]:
            body += "\n\n**Depends on:** " + ", ".join(f"#{n}" if n else d for d, n in zip(it["depends"], deps))
        body += f"\n\n<!-- backlog-key: {it['key']} -->"
        args = ["issue", "create", "-R", r, "--title", it["title"], "--body", body,
                "--milestone", MILESTONES[it["milestone"]]]
        for l in it["labels"]:
            args += ["--label", l]
        url = sh(["gh"] + args)
        number = int(url.rstrip("/").split("/")[-1])
        write_issue_number(it["key"], number)
        print(f"#{number} {it['title']}")
        if cfg.get("project"):
            sh(["gh", "project", "item-add", str(cfg["project"]["number"]),
                "--owner", cfg["project"]["owner"], "--url", url])


def open_issues():
    return gh_json(["issue", "list", "-R", repo(), "--state", "open", "--limit", "300",
                    "--json", "number,title,milestone,labels,assignees,body"])


DEPENDS_LINE = re.compile(r"^\*\*Depends on:\*\*(.*)$", re.M)


def dependencies(issues):
    """Issue number -> set of issue numbers it depends on (backlog plus 'Depends on:' in the body)."""
    _, items = parse_backlog()
    k2i = {it["key"]: it["issue"] for it in items}
    deps = {it["issue"]: {k2i.get(d) for d in it["depends"]} - {None} for it in items if it["issue"]}
    for i in issues:
        for m in DEPENDS_LINE.finditer(i.get("body") or ""):
            deps.setdefault(i["number"], set()).update(int(n) for n in re.findall(r"#(\d+)", m.group(1)))
    return deps


def open_blockers(issue, issues, deps):
    open_numbers = {i["number"] for i in issues}
    return sorted(d for d in deps.get(issue["number"], ()) if d in open_numbers)


def has_label(issue, *names):
    return any(l["name"] in names for l in issue["labels"])


def ready_issues(issues=None):
    issues = issues if issues is not None else open_issues()
    deps = dependencies(issues)
    ready = []
    for i in issues:
        if i["assignees"] or has_label(i, "status:in-progress", "status:blocked", "field-test", "needs-owner"):
            continue
        if open_blockers(i, issues, deps):
            continue
        ready.append(i)
    ready.sort(key=lambda i: ((i.get("milestone") or {}).get("title", "Z"), i["number"]))
    return ready


def cmd_next(_args):
    ready = ready_issues()
    if not ready:
        print("No ready issue. Check ./rp status (blocked, field tests, or owner tasks).")
        return
    i = ready[0]
    print(f"#{i['number']} {i['title']}  [{(i.get('milestone') or {}).get('title', '-')}]")
    print(f"Start with: ./rp start {i['number']}")


def cmd_status(_args):
    r = repo()
    print(f"== {r}")
    for m in sorted(gh_json(["api", f"repos/{r}/milestones?state=all&per_page=100"]), key=lambda m: m["title"]):
        tot = m["open_issues"] + m["closed_issues"]
        done = m["closed_issues"]
        bar = "#" * round(20 * done / tot) if tot else ""
        print(f"  {m['title']:<24} [{bar:<20}] {done}/{tot}")
    issues = open_issues()
    deps = dependencies(issues)
    print("\n== In progress")
    live = running_agents()
    for i in issues:
        if has_label(i, "status:in-progress"):
            n = i["number"]
            print(f"  #{n} {i['title']}")
            print(f"      {agent_status_line(n, read_agent_run(n), live.get(n))}")
    decisions = [i for i in issues if has_label(i, "needs-owner")]
    print("\n== Decisions for the owner (needs-owner: answer in the issue, then remove the label)")
    for i in decisions:
        print(f"  #{i['number']} {i['title']}")
    if not decisions:
        print("  none")
    tests = [i for i in issues if has_label(i, "field-test")]
    runnable = [i for i in tests if not open_blockers(i, issues, deps)]
    blocked = [i for i in tests if open_blockers(i, issues, deps)]
    print("\n== Field tests to run now (./rp install, then docs/FIELD_TESTING.md)")
    for i in runnable:
        print(f"  #{i['number']} {i['title']}")
    if not runnable:
        print("  none")
    if blocked:
        print("\n== Field tests not runnable yet")
        for i in blocked:
            waits = ", ".join(f"#{d}" for d in open_blockers(i, issues, deps))
            print(f"  #{i['number']} {i['title']}  (waits for {waits})")
    reports = [i for i in issues if has_label(i, "field-report")]
    if reports:
        print("\n== Open field reports (for an agent to triage)")
        for i in reports:
            print(f"  #{i['number']} {i['title']}")
    print("\n== Open PRs")
    for p in gh_json(["pr", "list", "-R", r, "--json", "number,title,headRefName"]):
        print(f"  !{p['number']} {p['title']} ({p['headRefName']})")
    print("\n== Next ready")
    for i in ready_issues(issues)[:5]:
        print(f"  #{i['number']} {i['title']}")


def slugify(s):
    return re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")[:40].rstrip("-")


WORKTREES = os.path.join(os.path.dirname(ROOT), os.path.basename(ROOT) + "-worktrees")


def start_issue(n, worktree=False):
    """Mark issue N In Progress and prepare its branch. Returns (title, branch, working dir)."""
    r = repo()
    issue = gh_json(["issue", "view", str(n), "-R", r, "--json", "title,state"])
    if issue["state"] != "OPEN":
        sys.exit(f"#{n} is not open")
    branch = f"issue-{n}-{slugify(issue['title'])}"
    sh(["git", "fetch", "origin"], check=False)
    exists = sh(["git", "branch", "--list", branch])
    base = "origin/main" if sh(["git", "rev-parse", "--verify", "-q", "origin/main"], check=False) else "main"
    if worktree:
        cwd = os.path.join(WORKTREES, branch)
        if not os.path.isdir(cwd):
            os.makedirs(WORKTREES, exist_ok=True)
            sh(["git", "worktree", "add", cwd, branch] if exists else
               ["git", "worktree", "add", "-b", branch, cwd, base])
        ensure_local_properties(cwd)
    else:
        cwd = ROOT
        current = sh(["git", "rev-parse", "--abbrev-ref", "HEAD"])
        if current != branch:
            if sh(["git", "status", "--porcelain"]):
                sys.exit("working tree not clean; commit or stash first (or use --worktree)")
            sh(["git", "checkout", branch] if exists else ["git", "checkout", "-b", branch, base])
    sh(["gh", "issue", "edit", str(n), "-R", r, "--add-assignee", "@me", "--add-label", "status:in-progress"])
    project_set_status(n, "In Progress")
    return issue["title"], branch, cwd


def cmd_start(args):
    if not args:
        sys.exit("usage: ./rp start <issue> [--worktree]")
    n = int(args[0].lstrip("#"))
    _, branch, cwd = start_issue(n, worktree="--worktree" in args)
    print(f"On branch {branch} in {cwd}. Issue #{n} is In Progress.")
    print(f"Read it: gh issue view {n}")


# ---------- agents ----------

AGENT_DEFAULTS = {
    "default_runner": "claude",
    "claude": {
        "model": None,
        "headless_args": ["--permission-mode", "auto"],
        "auto_args": ["--permission-mode", "bypassPermissions"],
    },
    "codex": {
        "model": None,
        # Codex always runs in its workspace-write sandbox, with network (Gradle, gh, git push) and
        # write access to .git (commits) and the build caches. With --worktree the worktree's own git
        # dir (.git/worktrees/<name>) is added at launch: Codex protects it otherwise.
        "sandbox_writable_roots": [".git", "~/.gradle", "~/.m2", "~/.android", "~/.konan"],
        "network_access": True,
        "headless_args": [],
        "auto_args": ["-a", "never"],
    },
}


def worktree_git_dir(cwd):
    """The per-worktree git dir (.git/worktrees/<name>) of a linked worktree, or None.

    Codex resolves the `.git` file of its working directory and makes that git dir read-only, even when
    it lies under a writable root, so a linked worktree's own git dir must be listed explicitly."""
    if not os.path.isfile(os.path.join(cwd, ".git")):
        return None
    r = subprocess.run(["git", "rev-parse", "--absolute-git-dir"], cwd=cwd, text=True, capture_output=True)
    return (r.stdout.strip() or None) if r.returncode == 0 else None


def git_common_dir():
    """The repository's shared .git directory, also when ./rp runs from a linked worktree."""
    r = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], cwd=ROOT,
                       text=True, capture_output=True)
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else os.path.join(ROOT, ".git")


def ensure_local_properties(cwd):
    """Copy the main checkout's ignored local.properties (sdk.dir) into the linked worktree `cwd`.

    `git worktree add` does not carry ignored files, so Gradle in a new worktree fails with "SDK location
    not found" unless ANDROID_HOME is set. An existing file is never overwritten. Returns the copied path,
    or None when nothing was copied."""
    dest = os.path.join(cwd, "local.properties")
    src = os.path.join(os.path.dirname(git_common_dir()), "local.properties")
    if os.path.exists(dest) or not os.path.isfile(src) or os.path.realpath(src) == os.path.realpath(dest):
        return None
    shutil.copyfile(src, dest)
    return dest


def codex_sandbox_args(acfg, cwd=ROOT):
    roots = []
    for p in acfg["codex"]["sandbox_writable_roots"]:
        p = os.path.expanduser(p)
        if p == ".git":
            p = git_common_dir()
        roots.append(p if os.path.isabs(p) else os.path.join(ROOT, p))
    git_dir = worktree_git_dir(cwd)
    if git_dir and git_dir not in roots:
        roots.append(git_dir)
    args = ["-s", "workspace-write", "-c", "sandbox_workspace_write.writable_roots=" + json.dumps(roots)]
    if acfg["codex"].get("network_access"):
        args += ["-c", "sandbox_workspace_write.network_access=true"]
    return args


def agent_config():
    cfg = load_config().get("agents", {})
    out = json.loads(json.dumps(AGENT_DEFAULTS))
    out["default_runner"] = cfg.get("default_runner", out["default_runner"])
    for runner in ("claude", "codex"):
        out[runner].update(cfg.get(runner, {}))
    return out


def agent_prompt(n, title, branch, headless, extra, auto=False):
    lines = [
        f"You are working on RunPro issue #{n}: {title}.",
        f"The issue is already started and you are on branch {branch}. Do not run ./rp start again.",
        "Follow AGENTS.md (the loop and the rules) and docs/GUIDE.md.",
        f"Read the issue with `gh issue view {n}` and the docs it points to.",
        "Implement it with tests (tests first for :core:* code), run ./rp check until it passes,",
        f"and commit with a message ending in (#{n}). No Co-Authored-By trailer.",
        "If you need the owner (a run on the watch, a decision, credentials): comment on the issue,",
        "add the label needs-owner, and stop.",
        "Use the gh CLI for GitHub (issue comments, labels, PRs), not a GitHub connector or MCP tool.",
    ]
    if auto:
        lines.append("You run in autonomous mode: never ask the user for confirmation and never wait for input. "
                     "When ./rp check passes, run ./rp pr yourself to push and open the PR. Never merge. "
                     "If you cannot finish, run ./rp handoff with what was done, what is next and open "
                     "problems, then stop.")
    elif headless:
        lines.append("Do not push and do not open a PR. When you finish or stop, run "
                     "./rp handoff with what was done, what is next and open problems.")
    else:
        lines.append("Ask me before running ./rp pr (it pushes and opens the PR).")
    if extra:
        lines.append(f"Additional instructions: {extra}")
    return "\n".join(lines)


def parse_agent_args(args):
    """Split `./rp agent` arguments into (opts, flags, target, extra CLI args after --)."""
    extra_cli = []
    if "--" in args:
        i = args.index("--")
        args, extra_cli = args[:i], args[i + 1:]
    opts = {"runner": None, "model": None, "prompt": None}
    flags, target = set(), None
    it = iter(args)
    for a in it:
        if a in ("--runner", "--model", "--prompt"):
            opts[a[2:]] = next(it, None)
        elif a in ("--headless", "--worktree", "--dry-run", "--auto"):
            flags.add(a[2:])
        elif a in ("claude", "codex") and opts["runner"] is None:
            opts["runner"] = a
        else:
            target = a
    return opts, flags, target, extra_cli


# ---------- where an agent runs ----------

LOCAL_HOSTS = {"localhost", "127.0.0.1", "::1", "0.0.0.0"}
LOCAL_CODEX_PROVIDERS = {"oss", "ollama", "lmstudio"}


def _flag_values(args, *names):
    """Every value of the options `names` in `args`, as `-x v` or `--xx=v`."""
    out = []
    for i, a in enumerate(args):
        for name in names:
            if a == name and i + 1 < len(args):
                out.append(args[i + 1])
            elif a.startswith(name + "="):
                out.append(a.split("=", 1)[1])
    return out


def _flag_value(args, *names):
    values = _flag_values(args, *names)
    return values[-1] if values else None


def _read_toml(path):
    try:
        import tomllib
        with open(path, "rb") as f:
            return tomllib.load(f)
    except (OSError, ValueError, ImportError):
        return {}


def _read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def is_local_url(url):
    from urllib.parse import urlparse
    host = (urlparse(url).hostname or "") if url else ""
    return host in LOCAL_HOSTS or host.endswith(".localhost")


def resolve_agent_target(runner, model, extra_cli, cwd=ROOT, env=None, home=None):
    """Where an agent runs: (model, provider, location), location "local" or "cloud".

    A null model in plan/config.json means the tool's own default, so read it from the tool's config.
    """
    env = os.environ if env is None else env
    home = home or os.path.expanduser("~")
    if runner == "codex":
        overrides = dict(v.split("=", 1) for v in _flag_values(extra_cli, "-c", "--config") if "=" in v)
        overrides = {k: v.strip("\"'") for k, v in overrides.items()}
        model = model or _flag_value(extra_cli, "-m", "--model") or overrides.get("model")
        if "--oss" in extra_cli:
            return model or "(oss default)", _flag_value(extra_cli, "--local-provider") or "oss", "local"
        cfg = _read_toml(os.path.join(env.get("CODEX_HOME") or os.path.join(home, ".codex"), "config.toml"))
        profile = _flag_value(extra_cli, "-p", "--profile") or cfg.get("profile")
        prof = cfg.get("profiles", {}).get(profile, {}) if profile else {}
        model = model or prof.get("model") or cfg.get("model") or "(codex default)"
        provider = overrides.get("model_provider") or prof.get("model_provider") or cfg.get("model_provider") \
            or "openai"
        base_url = cfg.get("model_providers", {}).get(provider, {}).get("base_url", "")
        local = provider in LOCAL_CODEX_PROVIDERS or is_local_url(base_url)
        return model, provider, "local" if local else "cloud"
    settings = {}
    for path in (os.path.join(home, ".claude", "settings.json"), os.path.join(cwd, ".claude", "settings.json"),
                 os.path.join(cwd, ".claude", "settings.local.json")):
        settings.update(_read_json(path))
    model = model or _flag_value(extra_cli, "--model") or env.get("ANTHROPIC_MODEL") or settings.get("model") \
        or "(claude default)"
    if env.get("CLAUDE_CODE_USE_BEDROCK"):
        return model, "bedrock", "cloud"
    if env.get("CLAUDE_CODE_USE_VERTEX"):
        return model, "vertex", "cloud"
    base_url = env.get("ANTHROPIC_BASE_URL", "")
    if is_local_url(base_url):
        return model, base_url, "local"
    return model, "anthropic", "cloud"


# ---------- agent run records (shared by all worktrees) ----------

def agent_runs_dir():
    return os.path.join(git_common_dir(), "rp-agents")


def write_agent_run(run):
    d = agent_runs_dir()
    os.makedirs(d, exist_ok=True)
    path = os.path.join(d, f"{run['issue']}.json")
    with open(path + ".tmp", "w") as f:
        json.dump(run, f, indent=2)
    os.replace(path + ".tmp", path)


def read_agent_run(n):
    run = _read_json(os.path.join(agent_runs_dir(), f"{n}.json"))
    return run or None


def _etime_seconds(etime):
    """ps etime `[[dd-]hh:]mm:ss` to seconds."""
    days, _, rest = etime.rpartition("-")
    parts = [int(p) for p in rest.split(":")]
    while len(parts) < 3:
        parts.insert(0, 0)
    return int(days or 0) * 86400 + parts[0] * 3600 + parts[1] * 60 + parts[2]


def running_agents(ps_output=None):
    """Live `./rp agent N` processes: {issue: {"pid", "seconds", "args"}}."""
    if ps_output is None:
        r = subprocess.run(["ps", "-eo", "pid=,etime=,command="], text=True, capture_output=True)
        ps_output = r.stdout if r.returncode == 0 else ""
    found = {}
    for line in ps_output.splitlines():
        parts = line.split(None, 2)
        if len(parts) < 3:
            continue
        pid, etime, command = parts
        m = re.search(r"(?:^|[\s/])rp agent(?:\s+(.*))?$", command)
        if not m:
            continue
        args = (m.group(1) or "").split()
        _, _, target, _ = parse_agent_args(args)
        if not target or not target.lstrip("#").isdigit():
            continue
        found[int(target.lstrip("#"))] = {"pid": int(pid), "seconds": _etime_seconds(etime), "args": args}
    return found


def _duration(seconds):
    seconds = int(seconds)
    if seconds < 3600:
        return f"{seconds // 60}m"
    if seconds < 86400:
        return f"{seconds // 3600}h{seconds % 3600 // 60:02d}m"
    return f"{seconds // 86400}d{seconds % 86400 // 3600}h"


def _where(model, provider, location):
    return f"{model} on {provider} ({location})"


def agent_status_line(n, run, live, now=None):
    """One line saying whether an agent works on issue N and where it runs."""
    now = now or time.time()
    if run and live and live["pid"] == run.get("pid"):
        return (f"running {_duration(live['seconds'])}: {run['runner']} {_where(run['model'], run['provider'], run['location'])}"
                f", {run['mode']}, pid {run['pid']}")
    if live:
        opts, _, _, extra = parse_agent_args(live["args"])
        runner = opts["runner"] or agent_config()["default_runner"]
        model, provider, location = resolve_agent_target(runner, opts["model"] or agent_config()[runner].get("model"),
                                                         extra)
        return (f"running {_duration(live['seconds'])}: {runner} {_where(model, provider, location)}"
                f", pid {live['pid']} (from the process list)")
    if not run:
        return "no agent running"
    what = f"{run['runner']} {_where(run['model'], run['provider'], run['location'])}"
    if run.get("ended") is not None:
        ago = _duration(now - run["ended"])
        return f"no agent running (last: {what}, exited {run.get('exit_code')} {ago} ago)"
    return f"no agent running (last: {what}, stopped without an exit code)"


def cmd_agent(args):
    opts, flags, target, extra_cli = parse_agent_args(args)
    acfg = agent_config()
    runner = opts["runner"] or acfg["default_runner"]
    if runner not in ("claude", "codex"):
        sys.exit("runner must be claude or codex")
    model = opts["model"] or acfg[runner].get("model")
    headless = "headless" in flags

    if target in (None, "next"):
        ready = ready_issues()
        if not ready:
            sys.exit("No ready issue (see ./rp status).")
        n = ready[0]["number"]
    else:
        n = int(target.lstrip("#"))

    if "dry-run" in flags:
        title = gh_json(["issue", "view", str(n), "-R", repo(), "--json", "title"])["title"]
        branch = f"issue-{n}-{slugify(title)}"
        cwd = os.path.join(WORKTREES, branch) if "worktree" in flags else ROOT
    else:
        title, branch, cwd = start_issue(n, worktree="worktree" in flags)

    auto = "auto" in flags
    prompt = agent_prompt(n, title, branch, headless, opts["prompt"], auto=auto)
    if runner == "claude":
        cmd = ["claude"]
        if model:
            cmd += ["--model", model]
        if auto:
            cmd += acfg["claude"]["auto_args"]
        elif headless:
            cmd += acfg["claude"]["headless_args"]
        if headless:
            cmd += ["-p"]
        cmd += extra_cli + [prompt]
    else:
        cmd = ["codex"]
        if auto and not headless:
            cmd += acfg["codex"]["auto_args"]  # approval policy is a top-level option
        if headless:
            cmd += ["exec"] + acfg["codex"]["headless_args"]
        cmd += codex_sandbox_args(acfg, cwd)
        if model:
            cmd += ["-m", model]
        cmd += ["-C", cwd] + extra_cli + [prompt]

    mode = ("headless" if headless else "interactive") + (" + auto (no confirmations)" if auto else "")
    real_model, provider, location = resolve_agent_target(runner, model, extra_cli, cwd=cwd)
    print(f"# #{n} {title}")
    print(f"# runner={runner} model={real_model} provider={provider} ({location}) mode={mode} cwd={cwd}")
    if "dry-run" in flags:
        print(" ".join(c if " " not in c and "\n" not in c else repr(c) for c in cmd))
        return
    run = {"issue": n, "runner": runner, "model": real_model, "provider": provider, "location": location,
           "mode": "headless" if headless else "auto" if auto else "interactive", "pid": os.getpid(), "cwd": cwd,
           "started": time.time(), "ended": None, "exit_code": None}
    write_agent_run(run)
    code = None
    try:
        code = subprocess.run(cmd, cwd=cwd).returncode
    finally:
        run.update(ended=time.time(), exit_code=code)
        write_agent_run(run)
    sys.exit(code)


def cmd_check(_args):
    if os.path.exists(os.path.join(ROOT, "gradlew")):
        if not (os.environ.get("ANDROID_HOME") or os.environ.get("ANDROID_SDK_ROOT")):
            copied = ensure_local_properties(ROOT)  # worktrees created before ./rp copied it
            if copied:
                print(f"Copied local.properties from the main checkout to {copied}", flush=True)
        r = subprocess.run(["./gradlew", "check", "--continue"], cwd=ROOT)
        sys.exit(r.returncode)
    print("No Gradle project yet (see the m0-gradle-skeleton issue). Nothing to check.")


def current_issue():
    b = sh(["git", "rev-parse", "--abbrev-ref", "HEAD"])
    m = re.match(r"issue-(\d+)-", b)
    if not m:
        sys.exit(f"branch {b} is not an issue branch")
    return b, int(m.group(1))


def cmd_pr(_args):
    branch, n = current_issue()
    r = repo()
    if sh(["git", "status", "--porcelain"]):
        sys.exit("uncommitted changes; commit first")
    sh(["git", "push", "-u", "origin", branch], capture=False)
    existing = gh_json(["pr", "list", "-R", r, "--head", branch, "--json", "url"])
    if existing:
        print(existing[0]["url"])
        return
    title = gh_json(["issue", "view", str(n), "-R", r, "--json", "title"])["title"]
    tpl = open(os.path.join(ROOT, ".github", "pull_request_template.md")).read()
    body = f"Closes #{n}\n\n" + tpl
    print(sh(["gh", "pr", "create", "-R", r, "--base", "main", "--head", branch,
              "--title", f"{title} (#{n})", "--body", body]))


def cmd_handoff(args):
    if not args:
        sys.exit('usage: ./rp handoff "what was done, what is next, open problems"')
    b = sh(["git", "rev-parse", "--abbrev-ref", "HEAD"], check=False)
    with open(HANDOFF, "a") as f:
        f.write(f"\n## {datetime.now():%Y-%m-%d %H:%M} · {b}\n\n{' '.join(args)}\n")
    print("handoff appended to docs/HANDOFF.md")


def cmd_install(args):
    if len(args) > 1:
        sys.exit("usage: ./rp install [SERIAL] (or set ANDROID_SERIAL)")
    if not os.path.exists(os.path.join(ROOT, "gradlew")):
        sys.exit("No Gradle project yet.")
    setup = "See docs/WATCH_SETUP.md."
    try:
        listing = sh(["adb", "devices", "-l"])
    except FileNotFoundError:
        sys.exit(f"adb not found. Install Android SDK platform-tools and add it to PATH. {setup}")
    print(listing, flush=True)
    devices = {}
    for line in listing.splitlines():
        fields = line.split()
        if len(fields) >= 2 and not line.startswith(("List of devices", "*")):
            devices[fields[0]] = fields[1]
    serial = args[0] if args else os.environ.get("ANDROID_SERIAL")
    if not serial:
        if not devices:
            sys.exit(f"No ADB devices found. Pair and connect the watch over Wi-Fi first. {setup}")
        if len(devices) != 1:
            sys.exit("Multiple ADB devices found. Use ./rp install SERIAL or set ANDROID_SERIAL. " + setup)
        serial = next(iter(devices))
    if serial not in devices:
        sys.exit(f"ADB device {serial} is not connected. Check adb devices -l and ANDROID_SERIAL. {setup}")
    if devices[serial] != "device":
        sys.exit(f"ADB device {serial} is {devices[serial]}. Authorize or reconnect the watch. {setup}")
    adb = ["adb", "-s", serial]
    characteristics = sh(adb + ["shell", "getprop", "ro.build.characteristics"])
    if "watch" not in characteristics.split(","):
        sys.exit(f"ADB device {serial} does not identify as a watch. Select the Wear OS device. {setup}")

    print(f"Building :wear for {serial}...", flush=True)
    r = subprocess.run(["./gradlew", ":wear:assembleDebug"], cwd=ROOT)
    if r.returncode != 0:
        sys.exit(r.returncode)
    apk = os.path.join(ROOT, "wear", "build", "outputs", "apk", "debug", "wear-debug.apk")
    if not os.path.isfile(apk):
        sys.exit(f"Wear debug APK not found after build: {apk}")
    print(f"Installing {apk} on {serial}...", flush=True)
    r = subprocess.run(adb + ["install", "-r", apk], cwd=ROOT)
    sys.exit(r.returncode)


COMMANDS = {"status": cmd_status, "next": cmd_next, "start": cmd_start, "check": cmd_check,
            "pr": cmd_pr, "agent": cmd_agent, "handoff": cmd_handoff, "install": cmd_install, "sync": cmd_sync}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        print(__doc__)
        sys.exit(1)
    COMMANDS[sys.argv[1]](sys.argv[2:])
